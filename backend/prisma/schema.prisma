generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique @db.VarChar(255)
  password       String          @db.VarChar(255)
  name           String          @db.VarChar(255)
  phone          String?         @db.VarChar(20)
  role           RoleEnum
  status         UserStatus      @default(PENDING)
  isActive       Boolean         @default(true)
  isFirstLogin   Boolean         @default(true)
  failedAttempts Int             @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  parent         Parent?
  passwordResets PasswordReset[]
  sessions       Session[]
  student        Student?
  teacher        Teacher?
  otps           Otp[]
  notifications  Notification[]

  @@index([email])
  @@map("users")
}

model Student {
  id         Int    @id @default(autoincrement())
  rollNumber String @unique @map("roll_number")
  userId     Int    @unique
  classId    Int    @map("class_id")

// Personal Details
  dateOfBirth   DateTime?  @map("date_of_birth")
  gender        Gender?    
  bloodGroup    String?    @map("blood_group") @db.VarChar(5)
  nationality   String?    @default("Indian") @db.VarChar(50)
  religion      String?    @db.VarChar(50)
  

// Contact Details
  address       String?    @db.Text
  city          String?    @db.VarChar(100)
  state         String?    @db.VarChar(100)
  phone         String?    @db.VarChar(20)  // Student's own phone
  
    // Parent/Guardian Details
  fatherName    String?    @map("father_name") @db.VarChar(255)
  motherName    String?    @map("mother_name") @db.VarChar(255)
  parentPhone   String?    @map("parent_phone") @db.VarChar(20)
  parentEmail   String?    @map("parent_email") @db.VarChar(255)
 // Academic Information
  admissionDate DateTime   @default(now()) @map("admission_date")
  previousSchool String?   @map("previous_school") @db.VarChar(255)
  previousClass  String?   @map("previous_class") @db.VarChar(50)
    // Documents
  profilePhoto  String?    @map("profile_photo") @db.VarChar(255)
  

  // Status
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime?   @updatedAt @map("updated_at")
  class      Class  @relation(fields: [classId], references: [id])
  user       User   @relation(fields: [userId], references: [id])

  @@index([classId], map: "students_class_id_fkey")
// ✅ ADD THESE RELATIONS
  attendances        Attendance[]
  attendanceSummaries AttendanceSummary[]
      examResults        ExamResult[]

  @@index([rollNumber])
  @@map("students")
}

model Teacher {
  id         Int    @id @default(autoincrement())
  employeeId String @unique @map("employee_id")
  userId     Int    @unique
  user       User   @relation(fields: [userId], references: [id])
  teacherAssignments TeacherAssignment[]  // ✅ ADD THIS LINE
  profilePhoto    String?   @map("profile_photo") @db.VarChar(255)
  // ========== REQUIRED FIELDS ==========
  qualification   String?   @db.VarChar(255)      // B.Ed, M.Ed, PhD, etc.
  specialization  String?   @db.VarChar(255)      // Mathematics, Science, English
  phone           String?   @db.VarChar(20)
  address         String?   @db.Text
  hireDate        DateTime? @map("hire_date")

    // Status
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime?  @updatedAt @map("updated_at")
  @@map("teachers")
}

model Parent {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  @@map("parents")
}

model Class {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(50)
  section  String    @db.VarChar(10)
  students Student[]
  classSubjects  ClassSubject[]  // Subjects taught in this class
    attendances      Attendance[]   
  @@unique([name, section])
    exams            Exam[]


  @@map("classes")
}

model Session {
  id               String   @id @default(cuid())
  userId           Int      @map("user_id")
  refreshToken     String   @unique @map("refresh_token")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ipAddress        String? 
  userAgent        String?
  isValid          Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(50)
  entityId  Int?     @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  status    String   @default("SUCCESS") @db.VarChar(20)
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum RoleEnum {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  SUPERADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
    INACTIVE   // ← Add this if needed
  DEACTIVATED // ← Or add this
}

enum OtpPurpose {
  ADMIN_VERIFICATION
  PASSWORD_RESET
  MFA
}

model Otp {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  code      String     @db.VarChar(10)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otps")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  message   String   @db.Text
  userId    Int      @map("user_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
// ============================================
// CLASS & SUBJECT MANAGEMENT MODELS (NEW)


model Subject {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)     // "Mathematics", "English"
  code        String    @unique @db.VarChar(20)  // "MATH101", "ENG101"
  description String?   @db.Text
  isActive    Boolean   @default(true)       @map("is_active")
  createdAt   DateTime  @default(now())      @map("created_at")
  updatedAt   DateTime  @updatedAt           @map("updated_at")
  
  // Relationships
  classSubjects    ClassSubject[]
    exams            Exam[]

  @@map("subjects")
}

model ClassSubject {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  subjectId   Int       @map("subject_id")
  isActive    Boolean   @default(true)       @map("is_active")
  createdAt   DateTime  @default(now())      @map("created_at")
  
  // Relationships
  class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  
  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model AcademicYear {
  id          Int       @id @default(autoincrement())
  year        String    @unique @db.VarChar(20)     // "2024-2025"
  isActive    Boolean   @default(false)             @map("is_active")
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  createdAt   DateTime  @default(now())              @map("created_at")
    exams            Exam[]

  // Relationships
  teacherAssignments TeacherAssignment[]
    attendanceSummaries AttendanceSummary[]

  @@map("academic_years")
}

model TeacherAssignment {
  id               Int       @id @default(autoincrement())
  teacherId        Int       @map("teacher_id")
  classSubjectId   Int       @map("class_subject_id")
  academicYearId   Int       @map("academic_year_id")
  isPrimary        Boolean   @default(true)      @map("is_primary")
  createdAt        DateTime  @default(now())     @map("created_at")
  updatedAt        DateTime  @updatedAt          @map("updated_at")
  
  // Relationships
  teacher          Teacher          @relation(fields: [teacherId], references: [id])
  classSubject     ClassSubject     @relation(fields: [classSubjectId], references: [id])
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  
  @@unique([teacherId, classSubjectId, academicYearId])
  @@map("teacher_assignments")
}
enum Gender {
  MALE
  FEMALE
  OTHER
}
// ============================================
// ATTENDANCE MANAGEMENT MODELS
// ============================================

// ============================================
// ATTENDANCE MANAGEMENT MODELS
// ============================================

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int              @map("student_id")
  classId   Int              @map("class_id")
  date      DateTime
  status    AttendanceStatus
  remark    String?          @db.Text
  markedBy  Int              @map("marked_by")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  
  // Relationships
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id])
  
  @@unique([studentId, date])
  @@index([classId])
  @@index([date])
  @@index([studentId])
  @@map("attendances")
}

model AttendanceSummary {
  id             Int      @id @default(autoincrement())
  studentId      Int      @map("student_id")
  academicYearId Int      @map("academic_year_id")
  totalDays      Int      @default(0) @map("total_days")
  presentDays    Int      @default(0) @map("present_days")
  absentDays     Int      @default(0) @map("absent_days")
  percentage     Float    @default(0)
  updatedAt      DateTime @default(now()) @map("updated_at")
  
  // Relationships
  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  
  @@unique([studentId, academicYearId])
  @@map("attendance_summaries")
}
model Holiday {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  date        DateTime
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@unique([date])
  @@map("holidays")
}
// ============================================
// EXAM MANAGEMENT MODELS
// ============================================

// Exam Type (Monthly Test, Half-Yearly, Final)
// ============================================
// EXAM MANAGEMENT MODELS
// ============================================

// Exam Type (Monthly Test, Half-Yearly, Final)
model ExamType {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?   @db.Text
  weightage   Int?      @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  exams       Exam[]
  
  @@map("exam_types")
}

// Exam Schedule
model Exam {
  id            Int       @id @default(autoincrement())
  examTypeId    Int       @map("exam_type_id")
  classId       Int       @map("class_id")
  subjectId     Int       @map("subject_id")
  academicYearId Int      @map("academic_year_id")
  name          String    @db.VarChar(100)
  examDate      DateTime  @map("exam_date")
  maxMarks      Int       @map("max_marks")
  passingMarks  Int       @map("passing_marks")
  isLocked      Boolean   @default(false) @map("is_locked")
  lockedAt      DateTime? @map("locked_at")
  lockedBy      Int?      @map("locked_by")
  description   String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relationships
  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  class         Class          @relation(fields: [classId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id])
  results       ExamResult[]
  
  @@index([classId])
  @@index([subjectId])
  @@index([examDate])
  @@map("exams")
}

// Exam Results
model ExamResult {
  id            Int       @id @default(autoincrement())
  examId        Int       @map("exam_id")
  studentId     Int       @map("student_id")
  marksObtained Decimal   @map("marks_obtained") @db.Decimal(5,2)
  percentage    Float?    
  grade         String?   @db.VarChar(5)
  remark        String?   @db.Text
  enteredBy     Int       @map("entered_by")
  enteredAt     DateTime  @default(now()) @map("entered_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relationships
  exam          Exam      @relation(fields: [examId], references: [id])
  student       Student   @relation(fields: [studentId], references: [id])
  
  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_results")
}

// Grade Scale
model GradeScale {
  id            Int       @id @default(autoincrement())
  grade         String    @unique @db.VarChar(5)
  minPercentage Float     @map("min_percentage")
  maxPercentage Float     @map("max_percentage")
  description   String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  @@map("grade_scales")
}